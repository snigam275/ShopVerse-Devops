# ShopVerse Environment Variables
# Copy this file to .env and customize as needed.

# ── PostgreSQL ──
POSTGRES_DB=shopverse
POSTGRES_USER=shopverse
POSTGRES_PASSWORD=shopverse_dev

# ── Product Service (Spring Boot) ──
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/shopverse
SPRING_DATASOURCE_USERNAME=shopverse
SPRING_DATASOURCE_PASSWORD=shopverse_dev

# ── Cart Service ──
PRODUCT_SERVICE_URL=http://product-service:8080

# ── For production (AWS RDS): ──
# SPRING_DATASOURCE_URL=jdbc:postgresql://<RDS_ENDPOINT>:5432/shopverse
# SPRING_DATASOURCE_USERNAME=<RDS_USERNAME>
# SPRING_DATASOURCE_PASSWORD=<RDS_PASSWORD>
